{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "branchPrefix": "dependencies/",
  "reviewers": ["wax911"],
  "baseBranchPatterns": [
    "develop"
  ],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "rebase",
  "packageRules": [
    {
      "groupName": "Sample Module Dependencies",
      "matchFileNames": [
        "sample/**"
      ],
      "matchPackageNames": [
        "/^androidx\\.activity/",
        "/^androidx\\.fragment/",
        "/^androidx\\.core/",
        "/^androidx\\.constraintlayout/",
        "/^androidx\\.swiperefreshlayout/",
        "/^androidx\\.preference/",
        "/^androidx\\.recyclerview/",
        "/^com\\.google\\.android\\.material/",
        "/^io\\.coil-kt/",
        "/^com\\.github\\.anitrend\\.support-arch/",
        "/^com\\.jakewharton\\.threetenabp/",
        "/^com\\.jakewharton\\.timber/"
      ]
    },
    {
      "groupName": "Room Dependencies",
      "matchFileNames": [
        "sample/**"
      ],
      "matchPackageNames": [
        "/^androidx\\.room/"
      ]
    },
    {
      "groupName": "Paging Dependencies",
      "matchFileNames": [
        "sample/**"
      ],
      "matchPackageNames": [
        "/^androidx\\.paging/"
      ]
    },
    {
      "groupName": "Kotlinx Serialization",
      "matchFileNames": [
        "sample/**"
      ],
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlinx\\.serialization/"
      ]
    },
    {
      "groupName": "Koin Dependencies",
      "matchFileNames": [
        "sample/**"
      ],
      "matchPackageNames": [
        "/^org\\.koin/"
      ]
    },
    {
      "groupName": "Testing Dependencies",
      "matchPackageNames": [
        "/^junit/",
        "/^io\\.mockk/",
        "/^androidx\\.test/",
        "/^androidx\\.test\\.espresso/",
        "/^androidx\\.test\\.ext/"
      ]
    }
  ]
}
